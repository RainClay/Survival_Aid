{
  "schemaVersion": 1,
  "id": "survival_aid",
  "version": "${version}",
  "name": "Carpet SurvivalAid",
  "icon": "assets/survival_aid/icon.png",
  "description": "A small Carpet extension that adds survival utility rules.",
  "authors": ["Rain_Clay"],
  "contact": {},
  "license": "Other",
  "environment": "*",
  "entrypoints": {
    "main": ["com.survivalaid.SurvivalAidExtension"],
    "carpet": ["com.survivalaid.SurvivalAidExtension"],
    "client": ["com.survivalaid.SurvivalAidClient"]
  },
  "mixins": ["survival_aid.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "=${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "carpet": "*"
  }
}
